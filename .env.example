# ===================== Multi-Agent SQL Analyst =====================
# Copy to .env and adjust as needed.

# --- LLM provider -------------------------------------------------
# mock: offline deterministic (no API key required, default)
# openai: any [OI]-compatible chat API ([OI], DeepSeek, Qwen, Moonshot, ...)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# e.g. https://api.deepseek.com/v1  or  https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# --- Database -----------------------------------------------------
# DB_PATH=data/sales.db
# DB_URL=sqlite:///F:/PythonProjects/langgraph/data/sales.db

# --- Workflow ------------------------------------------------------
MAX_SQL_RETRIES=3
MAX_REVIEW_RETRIES=2
SENSITIVE_COLUMNS=customer_phone,customer_email,email,phone,salary,address

# --- Charts --------------------------------------------------------
# CHART_FONT=SimHei

# --- LangSmith -----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-sql-analyst
